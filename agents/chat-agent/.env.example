# =============================================================================
# agents/chat-agent/.env.example
#
# Copy to .env and replace YOUR_PROJECT_ID with your GCP project ID:
#   cp .env.example .env
#   sed -i '' 's/YOUR_PROJECT_ID/my-project-id/g' .env
# =============================================================================

GCP_PROJECT_ID=YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# CRITICAL: gemini-3.5-flash is only available at the global Vertex AI endpoint.
# The RE is deployed to us-central1 but model inference routes to global.
GOOGLE_CLOUD_LOCATION=global
AGENT_GATEWAY_INGRESS=projects/YOUR_PROJECT_ID/locations/us-central1/agentGateways/aegis-ingress-gateway
AGENT_GATEWAY_EGRESS=projects/YOUR_PROJECT_ID/locations/us-central1/agentGateways/aegis-egress-gateway
# OTEL mTLS FIX: RE containers have mTLS certs — prevents SSL context corruption.
GOOGLE_API_USE_MTLS_ENDPOINT=never
# OTEL TCP-BLOCK FIX: telemetry.googleapis.com not in PSC routing — fail fast.
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_BSP_EXPORT_TIMEOUT_MILLIS=2000
OTEL_BSP_SCHEDULE_DELAY_MILLIS=15000
# aiohttp SINGLETON FIX: disables mTLS aiohttp path, forces httpx per-loop client.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
